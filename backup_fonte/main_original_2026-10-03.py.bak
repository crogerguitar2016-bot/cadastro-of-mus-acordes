                )
                + "/"
                + str(total_paginas)
                + "   Total: "
                + str(len(campos))
            )

        def pagina_anterior(*_):
            if self.pagina_campos > 0:
                self.pagina_campos -= 1
                atualizar()

        def pagina_proxima(*_):
            campos = self.carregar_campos()

            total_paginas = max(
                1,
                (
                    len(campos) + 3
                ) // 4
            )

            if (
                self.pagina_campos + 1
                < total_paginas
            ):
                self.pagina_campos += 1
                atualizar()

        anterior.bind(
            on_release=pagina_anterior
        )

        proximo.bind(
            on_release=pagina_proxima
        )

        novo.bind(
            on_release=lambda *_:
            self.novo_campo(
                atualizar
            )
        )

        fechar.bind(
            on_release=popup.dismiss
        )

        atualizar()
        popup.open()

    def novo_campo(self, ao_salvar):
        caixa = BoxLayout(
            orientation="vertical",
            spacing=dp(8),
            padding=dp(10)
        )

        nome = TextInput(
            hint_text="Nome do campo",
            multiline=False,
            size_hint_y=None,
            height=dp(50)
        )

        caixa.add_widget(
            Label(
                text="Nome do campo",
                size_hint_y=None,
                height=dp(28)
            )
        )

        caixa.add_widget(nome)

        caixa.add_widget(
            Label(
                text="Tipo do campo",
                size_hint_y=None,
                height=dp(28)
            )
        )

        tipo = {
            "valor": "Texto"
        }

        tipo_label = Label(
            text="Selecionado: Texto",
            size_hint_y=None,
            height=dp(30)
        )

        linha_tipos = BoxLayout(
            spacing=dp(6),
            size_hint_y=None,
            height=dp(52)
        )

        texto_btn = Button(
            text="TEXTO"
        )

        numero_btn = Button(
            text="NÚMERO"
        )

        sim_nao_btn = Button(
            text="SIM/NÃO"
        )

        linha_tipos.add_widget(
            texto_btn
        )

        linha_tipos.add_widget(
            numero_btn
        )

        linha_tipos.add_widget(
            sim_nao_btn
        )

        caixa.add_widget(
            linha_tipos
        )

        caixa.add_widget(
            tipo_label
        )

        aviso = Label(
            text="",
            size_hint_y=None,
            height=dp(35)
        )

        caixa.add_widget(aviso)

        botoes = BoxLayout(
            spacing=dp(8),
            size_hint_y=None,
            height=dp(52)
        )

        cancelar = Button(
            text="CANCELAR"
        )

        salvar = Button(
            text="SALVAR"
        )

        botoes.add_widget(cancelar)
        botoes.add_widget(salvar)

        caixa.add_widget(botoes)

        popup = Popup(
            title="Novo Campo",
            content=caixa,
            size_hint=(0.92, 0.78),
            auto_dismiss=False
        )

        def selecionar_tipo(valor):
            tipo["valor"] = valor

            tipo_label.text = (
                "Selecionado: "
                + valor
            )

        texto_btn.bind(
            on_release=lambda *_:
            selecionar_tipo("Texto")
        )

        numero_btn.bind(
            on_release=lambda *_:
            selecionar_tipo("Número")
        )

        sim_nao_btn.bind(
            on_release=lambda *_:
            selecionar_tipo("Sim/Não")
        )

        cancelar.bind(
            on_release=popup.dismiss
        )

        def confirmar(*_):
            nome_texto = nome.text.strip()

            if not nome_texto:
                aviso.text = (
                    "Digite o nome do campo."
                )
                return

            campos = self.carregar_campos()

            nomes_existentes = [
                item.get(
                    "nome",
                    ""
                ).strip().lower()
                for item in campos
            ]

            if (
                nome_texto.lower()
                in nomes_existentes
            ):
                aviso.text = (
                    "Esse campo já existe."
                )
                return

            campos.append({
                "id":
                    self.proximo_id_campo(),

                "nome":
                    nome_texto,

                "tipo":
                    tipo["valor"],

                "status":
                    "Ativo",
            })

            self.salvar_campos(
                campos
            )

            popup.dismiss()

            self.status.text = (
                "Campo criado: "
                + nome_texto
            )

            ao_salvar()

        salvar.bind(
            on_release=confirmar
        )

        popup.open()

    def visualizar_campo(
        self,
        campo,
        ao_atualizar
    ):
        caixa = BoxLayout(
            orientation="vertical",
            spacing=dp(10),
            padding=dp(12)
        )

        caixa.add_widget(
            Label(
                text=campo.get(
                    "nome",
                    ""
                ),
                font_size="20sp"
            )
        )

        caixa.add_widget(
            Label(
                text=(
                    "Tipo: "
                    + campo.get(
                        "tipo",
                        "Texto"
                    )
                )
            )
        )

        caixa.add_widget(
            Label(
                text=(
                    "Status: "
                    + campo.get(
                        "status",
                        "Ativo"
                    )
                )
            )
        )

        botoes = BoxLayout(
            spacing=dp(8),
            size_hint_y=None,
            height=dp(52)
        )

        status = Button(
            text=(
                "DESATIVAR"
                if campo.get(
                    "status",
                    "Ativo"
                ) == "Ativo"
                else "ATIVAR"
            )
        )

        fechar = Button(
            text="FECHAR"
        )

        botoes.add_widget(status)
        botoes.add_widget(fechar)

        caixa.add_widget(botoes)

        popup = Popup(
            title="Campo personalizado",
            content=caixa,
            size_hint=(0.88, 0.62),
            auto_dismiss=False
        )

        def alternar(*_):
            campos = self.carregar_campos()

            campo_id = campo.get("id")

            for item in campos:
                if item.get("id") == campo_id:
                    item["status"] = (
                        "Inativo"
                        if item.get(
                            "status",
                            "Ativo"
                        ) == "Ativo"
                        else "Ativo"
                    )

                    campo["status"] = (
                        item["status"]
                    )

                    break

            self.salvar_campos(
                campos
            )

            popup.dismiss()
            ao_atualizar()

        status.bind(
            on_release=alternar
        )

        fechar.bind(
            on_release=popup.dismiss
        )

        popup.open()

    def carregar_cadastros(self):
        if not self.arquivo_cadastros.exists():
            return []

        try:
            dados = json.loads(
                self.arquivo_cadastros.read_text(
                    encoding="utf-8"
                )
            )

            if isinstance(dados, list):
                return dados

        except Exception:
            pass

        return []

    def salvar_cadastros(self, cadastros):
        self.arquivo_cadastros.write_text(
            json.dumps(
                cadastros,
                ensure_ascii=False,
                indent=2
            ),
            encoding="utf-8"
        )

    def proximo_id_cadastro(self):
        cadastros = self.carregar_cadastros()

        ids = []

        for item in cadastros:
            try:
                ids.append(
                    int(item.get("id", 0))
                )
            except Exception:
                pass

        return max(ids, default=0) + 1

    def abrir_cadastros(self):
        caixa = BoxLayout(
            orientation="vertical",
            spacing=dp(7),
            padding=dp(10)
        )

        titulo = Label(
            text="CADASTROS",
            size_hint_y=None,
            height=dp(35),
            font_size="18sp"
        )

        caixa.add_widget(titulo)

        lista = BoxLayout(
            orientation="vertical",
            spacing=dp(6)
        )

        caixa.add_widget(lista)

        navegacao = BoxLayout(
            spacing=dp(6),
            size_hint_y=None,
            height=dp(50)
        )

        anterior = Button(
            text="ANTERIOR"
        )

        novo = Button(
            text="NOVO"
        )

        proximo = Button(
            text="PRÓXIMO"
        )

        navegacao.add_widget(anterior)
        navegacao.add_widget(novo)
        navegacao.add_widget(proximo)

        caixa.add_widget(navegacao)

        fechar = Button(
            text="FECHAR",
            size_hint_y=None,
            height=dp(48)
        )

        caixa.add_widget(fechar)

        popup = Popup(
            title="Cadastros",
            content=caixa,
            size_hint=(0.96, 0.92),
            auto_dismiss=False
        )

        def atualizar():
            lista.clear_widgets()

            cadastros = self.carregar_cadastros()

            por_pagina = 4

            total_paginas = max(
                1,
                (
                    len(cadastros)
                    + por_pagina - 1
                ) // por_pagina
            )

            if (
                self.pagina_cadastros
                >= total_paginas
            ):
                self.pagina_cadastros = (
                    total_paginas - 1
                )

            inicio = (
                self.pagina_cadastros
                * por_pagina
            )

            fim = inicio + por_pagina

            pagina = cadastros[
                inicio:fim
            ]

            if not pagina:
                lista.add_widget(
                    Label(
                        text="Nenhum cadastro."
                    )
                )

            for item in pagina:
                nome = item.get(
                    "nome",
                    ""
                )

                grupo = item.get(
                    "grupo",
                    ""
                )

                status = item.get(
                    "status",
                    "Ativo"
                )

                botao = Button(
                    text=(
                        nome
                        + " - "
                        + status
                        + "\n"
                        + grupo
                    ),
                    size_hint_y=None,
                    height=dp(65)
                )

                botao.bind(
                    on_release=lambda _b, i=item:
                    self.visualizar_cadastro(
                        i,
                        atualizar
                    )
                )

                lista.add_widget(
                    botao
                )

            titulo.text = (
                "CADASTROS  "
                + str(
                    self.pagina_cadastros + 1
                )
                + "/"
                + str(total_paginas)
                + "   Total: "
                + str(len(cadastros))
            )

        def pagina_anterior(*_):
            if self.pagina_cadastros > 0:
                self.pagina_cadastros -= 1
                atualizar()

        def pagina_proxima(*_):
            cadastros = self.carregar_cadastros()

            total_paginas = max(
                1,
                (
                    len(cadastros) + 3
                ) // 4
            )

            if (
                self.pagina_cadastros + 1
                < total_paginas
            ):
                self.pagina_cadastros += 1
                atualizar()

        anterior.bind(
            on_release=pagina_anterior
        )

        proximo.bind(
            on_release=pagina_proxima
        )

        novo.bind(
            on_release=lambda *_:
            self.novo_cadastro(
                atualizar
            )
        )

        fechar.bind(
            on_release=popup.dismiss
        )

        atualizar()
        popup.open()

    def escolher_combo(self, ao_escolher):
        combos = [
            "Violão",
            "Guitarra",
            "Contrabaixo",
            "Teclado",
            "Bateria",
        ]

        caixa = BoxLayout(
            orientation="vertical",
            spacing=dp(8),
            padding=dp(10)
        )

        titulo = Label(
            text="ESCOLHER COMBO",
            size_hint_y=None,
            height=dp(38),
            font_size="18sp"
        )

        caixa.add_widget(titulo)

        grade = GridLayout(
            cols=2,
            spacing=dp(8),
            size_hint_y=None,
            row_default_height=dp(58),
            row_force_default=True
        )

        grade.bind(
            minimum_height=grade.setter("height")
        )

        caixa.add_widget(grade)

        cancelar = Button(
            text="CANCELAR",
            size_hint_y=None,
            height=dp(48)
        )

        caixa.add_widget(cancelar)

        popup = Popup(
            title="Combo",
            content=caixa,
            size_hint=(0.92, 0.78),
            auto_dismiss=False
        )

        def selecionar(nome):
            ao_escolher(nome)
            popup.dismiss()

        for nome in combos:
            botao = Button(
                text=nome
            )

            botao.bind(
                on_release=lambda _b, n=nome:
                selecionar(n)
            )

            grade.add_widget(botao)

        cancelar.bind(
            on_release=popup.dismiss
        )

        popup.open()

    def novo_cadastro(self, ao_salvar):
        caixa = BoxLayout(
            orientation="vertical",
            spacing=dp(6),
            padding=dp(10)
        )

        nome = TextInput(
            hint_text="Nome",
            multiline=False,
            size_hint_y=None,
            height=dp(48)
        )

        contato = TextInput(
            hint_text="Contato",
            multiline=False,
            size_hint_y=None,
            height=dp(48)
        )

        combo = TextInput(
            hint_text="Escolha o combo",
            readonly=True,
            multiline=False,
            size_hint_y=None,
            height=dp(48)
        )

        escolher_combo = Button(
            text="ESCOLHER COMBO",
            size_hint_y=None,
            height=dp(48)
        )

        observacoes = TextInput(
            hint_text="Observações",
            multiline=True,
            size_hint_y=None,
            height=dp(90)
        )

        caixa.add_widget(nome)
        caixa.add_widget(contato)
        caixa.add_widget(combo)
        caixa.add_widget(escolher_combo)
        caixa.add_widget(observacoes)

        escolher_combo.bind(
            on_release=lambda *_:
            self.escolher_combo(
                lambda valor:
                setattr(
                    combo,
                    "text",
                    valor
                )
            )
        )

        aviso = Label(
            text="",
            size_hint_y=None,
            height=dp(30)
        )

        caixa.add_widget(aviso)

        botoes = BoxLayout(
            spacing=dp(8),
            size_hint_y=None,
            height=dp(50)
        )

        cancelar = Button(
            text="CANCELAR"
        )

        salvar = Button(
            text="SALVAR"
        )

        botoes.add_widget(cancelar)
        botoes.add_widget(salvar)

        caixa.add_widget(botoes)

        popup = Popup(
            title="Novo Cadastro",
            content=caixa,
            size_hint=(0.94, 0.88),
            auto_dismiss=False
        )

        cancelar.bind(
            on_release=popup.dismiss
        )

        def confirmar(*_):
            nome_texto = nome.text.strip()

            if not nome_texto:
                aviso.text = (
                    "Digite o nome."
                )
                return

            combo_texto = (
                combo.text.strip()
            )

            if not combo_texto:
                aviso.text = (
                    "Escolha um combo."
                )
                return

            cadastros = (
                self.carregar_cadastros()
            )

            cadastros.append({
                "id":
                    self.proximo_id_cadastro(),

                "nome":
                    nome_texto,

                "contato":
                    contato.text.strip(),

                "grupo":
                    combo_texto,

                "observacoes":
                    observacoes.text.strip(),

                "status":
                    "Ativo",

                "campos":
                    {},
            })

            self.salvar_cadastros(
                cadastros
            )

            popup.dismiss()

            self.status.text = (
                "Cadastro salvo: "
                + nome_texto
            )

            ao_salvar()

        salvar.bind(
            on_release=confirmar
        )

        popup.open()

    def salvar_valor_campo_cadastro(
        self,
        cadastro_id,
        campo,
        valor
    ):
        cadastros = self.carregar_cadastros()

        for item in cadastros:
            if item.get("id") == cadastro_id:
                if not isinstance(
                    item.get("campos"),
                    dict
                ):
                    item["campos"] = {}

                chave = str(
                    campo.get("id")
                )

                item["campos"][chave] = valor
                break

        self.salvar_cadastros(
            cadastros
        )

    def editar_campos_cadastro(
        self,
        cadastro,
        ao_atualizar
    ):
        campos = [
            campo
            for campo in self.carregar_campos()
            if campo.get(
                "status",
                "Ativo"
            ) == "Ativo"
        ]

        if not campos:
            self.status.text = (
                "Nenhum campo personalizado ativo."
            )
            return

        caixa = BoxLayout(
            orientation="vertical",
            spacing=dp(7),
            padding=dp(10)
        )

        titulo = Label(
            text="CAMPOS",
            size_hint_y=None,
            height=dp(38),
            font_size="18sp"
        )

        caixa.add_widget(titulo)

        lista = BoxLayout(
            orientation="vertical",
            spacing=dp(6)
        )

        caixa.add_widget(lista)

        navegacao = BoxLayout(
            spacing=dp(7),
            size_hint_y=None,
            height=dp(48)
        )

        anterior = Button(
            text="ANTERIOR"
        )

        proximo = Button(
            text="PRÓXIMO"
        )

        navegacao.add_widget(anterior)
        navegacao.add_widget(proximo)

        caixa.add_widget(navegacao)

        fechar = Button(
            text="FECHAR",
            size_hint_y=None,
            height=dp(48)
        )

        caixa.add_widget(fechar)

        popup = Popup(
            title=cadastro.get(
                "nome",
                "Cadastro"
            ),
            content=caixa,
            size_hint=(0.94, 0.90),
            auto_dismiss=False
        )

        pagina = {
            "numero": 0
        }

        def atualizar():
            lista.clear_widgets()

            cadastros = self.carregar_cadastros()

            atual = None

            for item in cadastros:
                if (
                    item.get("id")
                    == cadastro.get("id")
                ):
                    atual = item
                    break

            if atual is None:
                atual = cadastro

            valores = atual.get(
                "campos",
                {}
            )

            if not isinstance(
                valores,
                dict
            ):
                valores = {}

            por_pagina = 4

            total_paginas = max(
                1,
                (
                    len(campos)
                    + por_pagina - 1
                ) // por_pagina
            )

            if (
                pagina["numero"]
                >= total_paginas
            ):
                pagina["numero"] = (
                    total_paginas - 1
                )

            inicio = (
                pagina["numero"]
                * por_pagina
            )

            fim = inicio + por_pagina

            for campo in campos[
                inicio:fim
            ]:
                chave = str(
                    campo.get("id")
                )

                valor = valores.get(
                    chave,
                    "Não informado"
                )

                botao = Button(
                    text=(
                        campo.get(
                            "nome",
                            ""
                        )
                        + " - "
                        + campo.get(
                            "tipo",
                            "Texto"
                        )
                        + "\n"
                        + str(valor)
                    ),
                    size_hint_y=None,
                    height=dp(65)
                )

                botao.bind(
                    on_release=lambda _b, c=campo:
                    self.editar_valor_campo(
                        cadastro,
                        c,
                        atualizar
                    )
                )

                lista.add_widget(
                    botao
                )

            titulo.text = (
                "CAMPOS  "
                + str(
                    pagina["numero"] + 1
                )
                + "/"
                + str(total_paginas)
            )

        def pagina_anterior(*_):
            if pagina["numero"] > 0:
                pagina["numero"] -= 1
                atualizar()

        def pagina_proxima(*_):
            total_paginas = max(
                1,
                (
                    len(campos) + 3
                ) // 4
            )

            if (
                pagina["numero"] + 1
                < total_paginas
            ):
                pagina["numero"] += 1
                atualizar()

        anterior.bind(
            on_release=pagina_anterior
        )

        proximo.bind(
            on_release=pagina_proxima
        )

        fechar.bind(
            on_release=popup.dismiss
        )

        atualizar()
        popup.open()

    def editar_valor_campo(
        self,
        cadastro,
        campo,
        ao_salvar
    ):
        tipo = campo.get(
            "tipo",
            "Texto"
        )

        cadastros = self.carregar_cadastros()

        valor_atual = ""

        for item in cadastros:
            if (
                item.get("id")
                == cadastro.get("id")
            ):
                campos = item.get(
                    "campos",
                    {}
                )

                valor_atual = campos.get(
                    str(campo.get("id")),
                    ""
                )

                break

        caixa = BoxLayout(
            orientation="vertical",
            spacing=dp(10),
            padding=dp(12)
        )

        caixa.add_widget(
            Label(
                text=campo.get(
                    "nome",
                    ""
                ),
                size_hint_y=None,
                height=dp(40),
                font_size="18sp"
            )
        )

        aviso = Label(
            text="",
            size_hint_y=None,
            height=dp(35)
        )

        popup = Popup(
            title="Editar campo",
            content=caixa,
            size_hint=(0.90, 0.68),
            auto_dismiss=False
        )

        if tipo == "Sim/Não":
            caixa.add_widget(
                Label(
                    text=(
                        "Valor atual: "
                        + (
                            str(valor_atual)
                            if valor_atual
                            else "Não informado"
                        )
                    )
                )
            )

            botoes_valor = BoxLayout(
                spacing=dp(8),
                size_hint_y=None,
                height=dp(55)
            )

            sim = Button(
                text="SIM"
            )

            nao = Button(
                text="NÃO"
            )

            botoes_valor.add_widget(sim)
            botoes_valor.add_widget(nao)

            caixa.add_widget(
                botoes_valor
            )

            caixa.add_widget(aviso)

            cancelar = Button(
                text="CANCELAR",
                size_hint_y=None,
                height=dp(50)
            )

            caixa.add_widget(
                cancelar
            )

            def salvar_sim_nao(valor):
                self.salvar_valor_campo_cadastro(
                    cadastro.get("id"),
                    campo,
                    valor
                )

                popup.dismiss()
                ao_salvar()

            sim.bind(
                on_release=lambda *_:
                salvar_sim_nao("Sim")
            )

            nao.bind(
                on_release=lambda *_:
                salvar_sim_nao("Não")
            )

            cancelar.bind(
                on_release=popup.dismiss
            )

        else:
            entrada = TextInput(
                text=str(valor_atual),
                multiline=False,
                size_hint_y=None,
                height=dp(52)
            )

            caixa.add_widget(
                entrada
            )

            caixa.add_widget(
                aviso
            )

            botoes = BoxLayout(
                spacing=dp(8),
                size_hint_y=None,
                height=dp(52)
            )

            cancelar = Button(
                text="CANCELAR"
            )

            salvar = Button(
                text="SALVAR"
            )

            botoes.add_widget(
                cancelar
            )

            botoes.add_widget(
                salvar
            )

            caixa.add_widget(
                botoes
            )

            cancelar.bind(
                on_release=popup.dismiss
            )

            def confirmar(*_):
                valor = entrada.text.strip()

                if tipo == "Número":
                    if not valor:
                        aviso.text = (
                            "Digite um número."
                        )
                        return

                    try:
                        float(
                            valor.replace(
                                ",",
                                "."
                            )
                        )
                    except Exception:
                        aviso.text = (
                            "Valor numérico inválido."
                        )
                        return

                self.salvar_valor_campo_cadastro(
                    cadastro.get("id"),
                    campo,
                    valor
                )

                popup.dismiss()
                ao_salvar()

            salvar.bind(
                on_release=confirmar
            )

        popup.open()

    def visualizar_cadastro(
        self,
        cadastro,
        ao_atualizar
    ):
        caixa = BoxLayout(
            orientation="vertical",
            spacing=dp(8),
            padding=dp(12)
        )

        caixa.add_widget(
            Label(
                text=cadastro.get(
                    "nome",
                    ""
                ),
                size_hint_y=None,
                height=dp(45),
                font_size="19sp"
            )
        )

        caixa.add_widget(
            Label(
                text=(
                    "Contato: "
                    + cadastro.get(
                        "contato",
                        ""
                    )
                ),
                size_hint_y=None,
                height=dp(38)
            )
        )

        caixa.add_widget(
            Label(
                text=(
                    "Combo: "
                    + cadastro.get(
                        "grupo",
                        ""
                    )
                ),
                size_hint_y=None,
                height=dp(38)
            )
        )

        caixa.add_widget(
            Label(
                text=(
                    "Status: "
                    + cadastro.get(
                        "status",
                        "Ativo"
                    )
                ),
                size_hint_y=None,
                height=dp(38)
            )
        )

        observacoes = cadastro.get(
            "observacoes",
            ""
        )

        if len(observacoes) > 180:
            observacoes = (
                observacoes[:177]
                + "..."
            )

        caixa.add_widget(
            Label(
                text=(
                    "Observações:\n"
                    + observacoes
                )
            )
        )

        botoes = BoxLayout(
            spacing=dp(8),
            size_hint_y=None,
            height=dp(50)
        )

        status = Button(
            text=(
                "DESATIVAR"
                if cadastro.get(
                    "status",
                    "Ativo"
                ) == "Ativo"
                else "ATIVAR"
            )
        )

        campos_btn = Button(
            text="CAMPOS"
        )

        fechar = Button(
            text="FECHAR"
        )

        botoes.add_widget(status)
        botoes.add_widget(campos_btn)
        botoes.add_widget(fechar)

        caixa.add_widget(botoes)

        popup = Popup(
            title="Detalhes",
            content=caixa,
            size_hint=(0.92, 0.80),
            auto_dismiss=False
        )

        def alternar(*_):
            cadastros = (
                self.carregar_cadastros()
            )

            cadastro_id = cadastro.get("id")

            for item in cadastros:
                if item.get("id") == cadastro_id:
                    item["status"] = (
                        "Inativo"
                        if item.get(
                            "status",
                            "Ativo"
                        ) == "Ativo"
                        else "Ativo"
                    )

                    cadastro["status"] = (
                        item["status"]
                    )
                    break

            self.salvar_cadastros(
                cadastros
            )

            popup.dismiss()
            ao_atualizar()

        status.bind(
            on_release=alternar
        )

        def abrir_campos(*_):
            popup.dismiss()

            self.editar_campos_cadastro(
                cadastro,
                ao_atualizar
            )

        campos_btn.bind(
            on_release=abrir_campos
        )

        fechar.bind(
            on_release=popup.dismiss
        )

        popup.open()


class AplicativoGerado(App):

    def build(self):
        self.title = NOME_APP
        return CadastroPlanilha()


if __name__ == "__main__":
    AplicativoGerado().run()
