        )

        def atualizar():
            lista.clear_widgets()

            campos = self.carregar_campos()

            por_pagina = 4

            total_paginas = max(
                1,
                (
                    len(campos)
                    + por_pagina - 1
                ) // por_pagina
            )

            if (
                self.pagina_campos
                >= total_paginas
            ):
                self.pagina_campos = (
                    total_paginas - 1
                )

            inicio = (
                self.pagina_campos
                * por_pagina
            )

            fim = inicio + por_pagina

            pagina = campos[
